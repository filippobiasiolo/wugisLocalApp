{
  "name": "wugislocalapp",
  "version": "1.0.0",
  "description": "Wugis Local App",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never",
    "publish": "electron-builder --win nsis --x64 --publish always",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Wugis",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/filippobiasiolo/wugisLocalApp.git"
  },
  "build": {
    "appId": "com.wugis.localapp",
    "productName": "Wugis Local App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**",
      "!CONTEXT.md",
      "!docs/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "filippobiasiolo",
      "repo": "wugisLocalApp",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1"
  },
  "dependencies": {
    "electron-tabs": "^1.0.4",
    "electron-updater": "^6.8.9",
    "motion": "^12.40.0",
    "node-machine-id": "^1.1.12"
  }
}
