{
  "name": "wugislocalapp",
  "version": "1.0.0",
  "description": "Wugis Local App",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.wugis.localapp",
    "productName": "Wugis Local App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1"
  },
  "dependencies": {
    "electron-tabs": "^1.0.4",
    "motion": "^12.40.0",
    "node-machine-id": "^1.1.12"
  }
}
